# Documentation only: Ktor reads process environment variables, not this file.
# Set values privately using a local secret manager or masked prompt.
DATABASE_URL=jdbc:postgresql://localhost:5432/vidoora_db
DB_USERNAME=vidoora
DB_PASSWORD=
JWT_SECRET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RAW_BUCKET_NAME=vidoora-raw-uploads
R2_PROCESSED_BUCKET_NAME=vidoora-processed-hls
R2_MOCK_MODE=false
# Dedicated live integration test only
R2_TEST_BUCKET=vidoora-test-upload-verification
VIDOORA_LIVE_R2_TEST=false
# Phase 4: separate processor, not automatically started by the API.
# Point these at locally installed executables. No secrets go in this file.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PROCESSING_WORK_DIR=build/processing-work
# Opt-in tests: FFmpeg is local; PostgreSQL uses a fresh temporary schema per run.
VIDOORA_FFMPEG_TEST=false
VIDOORA_POSTGRES_TEST=false

VIDOORA_LIVE_PROCESSING_TEST=false

# Play Billing checkout remains unavailable; verified reads and receipt recovery are opt-in.
# Do not store Google service-account JSON, purchase tokens or receipt-encryption keys here.
# See docs/play-billing-receipts.md before privately configuring the later runtime integration.

# Keep false until private Google/receipt configuration and licence testing are ready.
# This enables verified read-side benefits only, never checkout or mock premium.
PLAY_MEMBERSHIP_READ_ENABLED=false
PLAY_CREDENTIALS_FILE=
PLAY_RECEIPT_KEY=
PLAY_PRODUCT_ID=
PLAY_DAY_BASE_PLAN=
PLAY_WEEK_BASE_PLAN=
PLAY_MONTHLY_BASE_PLAN=
PLAY_ALLOW_TEST_PURCHASES=false

# Durable receipt verification/recovery; requires verified reads and private Google configuration. Checkout remains disabled.
PLAY_PURCHASE_RECOVERY_ENABLED=false
# Internal licence testing only; requires read/recovery/test-purchase flags. Default OFF.
PLAY_INTERNAL_TEST_CHECKOUT_ENABLED=false

# Optional private segment delivery. Keep OFF until hosted HTTPS and Worker are verified.
# Separate random secret shared privately with Worker EDGE_SECRET; never put it in Android.
MEDIA_EDGE_ENABLED=false
MEDIA_EDGE_SECRET=

# Private downloads require actual verified Week/Monthly grants from the membership configuration above.
# There is no local/mock paid override and no new download credential to paste into chat.

# Optional email recovery. Resend verified sender required; server only.
PASSWORD_RESET_RESEND_KEY=
PASSWORD_RESET_FROM=

# Alternative without owning a domain: Gmail with 2-Step Verification and a private app password.
# Use one sender configuration only. Never put the Gmail login password here.
PASSWORD_RESET_GMAIL_USER=
PASSWORD_RESET_GMAIL_APP_PASSWORD=
PUBLIC_SHARE_ORIGIN=
